<style>
/* ---------- hero ---------- */
.hero{min-height:min(100svh,940px); display:flex; align-items:center;
  padding-block:clamp(90px,13vh,150px) clamp(70px,10vh,120px); overflow:hidden}
.hero-art{position:absolute; inset:0; z-index:0}
.hero-art picture,.hero-art img{width:100%; height:100%; display:block}
.hero-art img{object-fit:cover; object-position:52% 42%}
@media (max-width:900px){.hero-art img{object-position:50% 30%}}
.hero-art::after{content:""; position:absolute; inset:0;
  background:
   radial-gradient(120% 90% at 22% 55%, rgba(5,2,14,.94) 0%, rgba(5,2,14,.72) 38%, rgba(5,2,14,.1) 66%, transparent 78%),
   linear-gradient(180deg, rgba(8,12,24,.86) 0%, transparent 26%, transparent 62%, var(--ground) 99%);
}
@media (max-width:900px){
  .hero-art::after{background:
    linear-gradient(180deg, rgba(5,2,14,.9) 0%, rgba(5,2,14,.55) 34%, rgba(5,2,14,.86) 70%, var(--ground) 99%)}
}
.hero .wrap{position:relative; z-index:2}
.hero-copy{max-width:min(640px,100%)}
@media (max-width:900px){.hero .wrap{text-align:center}.hero-copy{margin-inline:auto}}
.eyebrow{display:inline-flex; flex-wrap:wrap; gap:8px 14px; align-items:center;
  font-weight:700; font-size:.71rem; letter-spacing:.19em; text-transform:uppercase;
  color:var(--violet-lite); margin-bottom:24px}
.eyebrow s{width:4px; height:4px; border-radius:50%; background:var(--violet); text-decoration:none}
h1 em{font-style:normal; color:var(--violet-lite)}
.hero-sub{margin-top:24px; max-width:50ch}
.hero-cta{margin-top:36px; display:flex; flex-wrap:wrap; gap:16px 20px; align-items:center}
@media (max-width:900px){.hero-cta,.eyebrow{justify-content:center}.hero-sub{margin-inline:auto}}
.hero-micro{margin-top:20px}
/* ---------- the clip reel: real captures, not mock-ups ---------- */
.reel{display:grid; gap:clamp(22px,3vw,36px); grid-template-columns:repeat(3,minmax(0,1fr));
  margin-bottom:clamp(46px,6vw,76px)}
@media (max-width:900px){.reel{grid-template-columns:1fr; max-width:330px; margin-inline:auto}}
.clip{margin:0; display:flex; flex-direction:column; gap:15px}
.clip .phone{width:100%}
.clip figcaption b{display:block; font-family:Fraunces,Georgia,serif; font-weight:800;
  font-size:1.22rem; color:#fff; margin-bottom:5px; letter-spacing:-.01em}
.clip figcaption span{display:block; color:var(--dim); font-size:.87rem; line-height:1.5}
.clip figcaption i{font-style:normal; color:var(--violet-lite); font-weight:600}

/* ---------- stat strip ---------- */
.stats{border-block:1px solid var(--line-soft); background:linear-gradient(180deg,rgba(18,26,46,.55),rgba(8,12,24,.2))}
.stats .wrap{display:grid; grid-template-columns:repeat(4,1fr); gap:4px; padding-block:30px}
@media (max-width:720px){.stats .wrap{grid-template-columns:repeat(2,1fr); gap:26px 4px}}
.stat{text-align:center; padding-inline:8px}
.stat b{display:block; font-family:Fraunces,serif; font-weight:800; font-size:clamp(1.7rem,3.6vw,2.3rem);
  line-height:1; color:var(--ink); font-variant-numeric:tabular-nums}
.stat span{display:block; margin-top:9px; font-size:.7rem; letter-spacing:.16em;
  text-transform:uppercase; color:var(--dim); font-weight:600}

/* ---------- the toy ---------- */
.toy-band{background:linear-gradient(180deg,var(--ground),var(--void) 55%,var(--ground))}
.toy{position:relative; border:1px solid var(--line); border-radius:22px; overflow:hidden;
  background:#06040f; box-shadow:0 30px 70px -34px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.06);
  cursor:pointer; touch-action:manipulation}
.toy canvas{display:block; width:100%; height:clamp(300px,42vw,392px)}
.toy-hud{position:absolute; top:14px; left:14px; right:14px; display:flex; justify-content:space-between;
  gap:12px; pointer-events:none; font-weight:700}
.chip{background:rgba(10,14,28,.78); border:1px solid var(--line); border-radius:999px;
  padding:7px 15px; font-size:.76rem; letter-spacing:.13em; text-transform:uppercase;
  color:var(--ink-2); backdrop-filter:blur(7px); font-variant-numeric:tabular-nums}
.chip.rec{color:var(--gold); border-color:rgba(255,215,106,.4)}
.toy-start{position:absolute; inset:0; display:grid; place-content:center; gap:14px; justify-items:center;
  background:radial-gradient(circle at 50% 55%,rgba(6,4,15,.35),rgba(6,4,15,.86));
  transition:opacity .35s ease}
.toy-start.gone{opacity:0; pointer-events:none}
.toy-start b{font-family:Fraunces,serif; font-weight:800; font-size:clamp(1.4rem,3.4vw,2rem); color:#fff;
  letter-spacing:-.01em}
.toy-start i{font-style:normal; font-size:.75rem; letter-spacing:.19em; text-transform:uppercase;
  color:var(--violet-lite); font-weight:700}
.toy-foot{margin-top:18px; display:flex; flex-wrap:wrap; gap:10px 26px; justify-content:space-between; align-items:baseline}
.reveal{color:var(--violet-lite); font-weight:600; font-size:.9rem; opacity:0; transform:translateY(4px);
  transition:opacity .5s ease,transform .5s ease}
.reveal.on{opacity:1; transform:none}
.sheet{display:grid; grid-template-columns:repeat(8,1fr); gap:6px; border:1px solid var(--line);
  border-radius:18px; padding:14px; background:#06040f}
.sheet img{width:100%; height:auto; opacity:.92}
@media (max-width:640px){.sheet{grid-template-columns:repeat(4,1fr)}}

/* ---------- modes ---------- */
.modes-band{background:var(--deep); border-block:1px solid var(--line-soft)}
.modes-grid{display:grid; gap:clamp(34px,5vw,60px); grid-template-columns:minmax(0,1fr) 300px; align-items:start}
@media (max-width:940px){.modes-grid{grid-template-columns:1fr}}
.mlist{display:grid; gap:12px}
.mode{display:flex; gap:16px; align-items:center; padding:16px 18px; border-radius:16px;
  border:1px solid var(--line-soft); background:linear-gradient(180deg,rgba(24,33,58,.72),rgba(12,18,34,.72));
  position:relative; overflow:hidden}
.mode::before{content:""; position:absolute; left:0; top:0; bottom:0; width:3px;
  background:var(--accent); opacity:.85}
.mode .dot{width:42px; height:42px; border-radius:12px; flex:none; position:relative;
  background:radial-gradient(circle at 50% 45%, color-mix(in srgb,var(--accent) 42%,transparent), rgba(6,4,15,.9) 72%);
  border:1px solid color-mix(in srgb,var(--accent) 45%,transparent)}
.mode .dot::after{content:""; position:absolute; inset:0; margin:auto; width:14px; height:14px; border-radius:50%;
  background:var(--accent); box-shadow:0 0 14px var(--accent); opacity:.9}
.mode.hole .dot::after{background:#06040f; box-shadow:0 0 0 3px var(--accent),0 0 18px var(--accent)}
.mode h3{margin:0; letter-spacing:.05em; text-transform:uppercase; font-family:Figtree,sans-serif; font-weight:800; font-size:.95rem}
.mode p{color:var(--dim); font-size:.88rem; margin-top:3px; line-height:1.45}
.mode .tag{margin-left:auto; flex:none; font-size:.66rem; font-weight:700; letter-spacing:.13em;
  text-transform:uppercase; color:var(--faint); border:1px solid var(--line); border-radius:999px; padding:5px 11px}
.mode.locked{opacity:.62}

/* ---------- the road / chart ---------- */
.road-band{position:relative; overflow:hidden}
.road-art{position:absolute; inset:0; z-index:0}
.road-art img{width:100%; height:100%; object-fit:cover}
.road-art::after{content:""; position:absolute; inset:0;
  background:linear-gradient(180deg,var(--ground),rgba(8,12,24,.82) 30%,rgba(8,12,24,.86) 70%,var(--ground))}
.road-band .wrap{position:relative; z-index:2}
.road-grid{display:grid; gap:clamp(36px,5vw,64px); grid-template-columns:300px minmax(0,1fr); align-items:center}
@media (max-width:940px){.road-grid{grid-template-columns:1fr}}
.goldline{font-family:Fraunces,serif; font-weight:800; color:var(--gold);
  font-size:clamp(1.5rem,3.4vw,2.15rem); letter-spacing:-.01em; font-variant-numeric:tabular-nums;
  display:flex; flex-wrap:wrap; gap:8px 16px; align-items:baseline; margin-top:26px}
.goldline s{text-decoration:none; color:rgba(255,215,106,.42)}
</style>

<style>
/* ---------- fitting room ---------- */
.fit-band{background:linear-gradient(180deg,var(--ground),#07040f 50%,var(--ground)); overflow:hidden}
.case-grid{display:grid; gap:clamp(24px,3vw,44px); align-items:center;
  grid-template-columns:minmax(0,1.16fr) minmax(0,1fr) minmax(0,1fr)}
.case-grid > .shot{align-items:center}
.case-grid .phone{width:100%}
@media (max-width:1040px){.case-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:680px){.case-grid{grid-template-columns:1fr; max-width:350px; margin-inline:auto}}
/* the game's own display case, rebuilt in CSS */
.case{position:relative; border-radius:20px; padding:26px 22px 22px; overflow:hidden;
  background:
    radial-gradient(64% 48% at 50% 4%, color-mix(in srgb,var(--accent) 17%,transparent), transparent 68%),
    linear-gradient(180deg,#120c26,#07040f 70%);
  border:1px solid color-mix(in srgb,var(--accent) 34%,var(--line));
  box-shadow:0 34px 76px -34px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.09);
  transition:border-color .5s ease}
.case-beam{position:absolute; left:50%; top:-10%; width:54%; height:66%; transform:translateX(-50%);
  background:radial-gradient(60% 100% at 50% 0%,color-mix(in srgb,var(--accent) 26%,transparent),transparent 72%);
  filter:blur(16px); pointer-events:none; transition:background .5s ease}
.case-floor{position:absolute; left:50%; bottom:86px; width:62%; height:22px; transform:translateX(-50%);
  border-radius:50%; background:radial-gradient(ellipse,color-mix(in srgb,var(--accent) 42%,transparent),transparent 72%);
  filter:blur(9px); transition:background .5s ease}
.case-cnr{position:absolute; width:20px; height:20px; border:2px solid color-mix(in srgb,var(--accent) 60%,transparent);
  opacity:.7; transition:border-color .5s ease}
.case-cnr.tl{top:11px; left:11px; border-right:0; border-bottom:0; border-radius:6px 0 0 0}
.case-cnr.tr{top:11px; right:11px; border-left:0; border-bottom:0; border-radius:0 6px 0 0}
.case-cnr.bl{bottom:11px; left:11px; border-right:0; border-top:0; border-radius:0 0 0 6px}
.case-cnr.br{bottom:11px; right:11px; border-left:0; border-top:0; border-radius:0 0 6px 0}
.case-plate{position:relative; text-align:center; font-size:.66rem; font-weight:700; letter-spacing:.24em;
  text-transform:uppercase; color:color-mix(in srgb,var(--accent) 78%,#fff); margin-bottom:6px}
.case-stage{position:relative; height:236px; display:grid; place-items:center}
.case-stage img{width:214px; height:214px; object-fit:contain;
  filter:drop-shadow(0 16px 30px rgba(0,0,0,.75)); animation:hover 5.6s ease-in-out infinite}
@keyframes hover{0%,100%{transform:translateY(-5px)}50%{transform:translateY(6px)}}
.case-name{position:relative; text-align:center; margin-top:4px}
.case-name b{font-family:Fraunces,serif; font-weight:800; font-size:1.5rem; display:block; color:#fff}
.case-name span{font-size:.72rem; letter-spacing:.16em; text-transform:uppercase; color:var(--dim); font-weight:600}
/* wardrobe wall */
.wall{margin-top:clamp(34px,5vw,54px)}
.rail{display:flex; gap:10px; overflow:hidden; -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.rail-in{display:flex; gap:10px; flex:none; animation:drift 62s linear infinite}
.rail.rev{margin-top:10px}
.rail.rev .rail-in{animation-direction:reverse}
.rail:hover .rail-in{animation-play-state:paused}
@keyframes drift{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.sw{flex:none; width:88px; height:88px; border-radius:15px; border:1px solid var(--line-soft);
  background:linear-gradient(180deg,rgba(24,33,58,.8),rgba(8,6,18,.8)); padding:6px; cursor:pointer;
  transition:border-color .2s ease, transform .2s ease, background .2s ease; position:relative}
.sw img{width:100%; height:100%; object-fit:contain}
.sw:hover{transform:translateY(-3px)}
.sw[aria-pressed="true"]{border-color:var(--accent); background:radial-gradient(circle at 50% 30%,color-mix(in srgb,var(--accent) 22%,transparent),rgba(8,6,18,.9))}
.sw.upcoming{border-style:dashed; border-color:color-mix(in srgb,var(--violet) 55%,var(--line-soft))}
.sw-tag{position:absolute; left:6px; right:6px; bottom:5px; text-align:center;
  font-family:Figtree,sans-serif; font-style:normal; font-weight:800; font-size:.58rem;
  letter-spacing:.14em; text-transform:uppercase; color:var(--violet-lite);
  background:rgba(8,6,18,.82); border:1px solid color-mix(in srgb,var(--violet) 45%,transparent);
  border-radius:999px; padding:2px 0; pointer-events:none}
.sw.upcoming img{opacity:.92}
@media (prefers-reduced-motion:reduce){
  .rail{-webkit-mask-image:none; mask-image:none; overflow-x:auto; flex-wrap:wrap}
  .rail-in{flex-wrap:wrap; animation:none}
  .case-stage img{animation:none}
}

/* ---------- answers ---------- */
.ans-band{background:var(--deep); border-block:1px solid var(--line-soft)}
.ans{display:grid; gap:30px 46px; grid-template-columns:repeat(2,minmax(0,1fr))}
@media (max-width:820px){.ans{grid-template-columns:1fr}}
.ans > div{border-left:2px solid var(--line); padding-left:20px}
.ans h3{color:#fff; margin-bottom:8px; font-family:Figtree,sans-serif; font-weight:800; font-size:.98rem}
.ans p{color:var(--dim); font-size:.94rem}
.ans b{color:var(--gold); font-weight:700}

/* ---------- close ---------- */
.close{position:relative; text-align:center; overflow:hidden; padding-block:clamp(100px,15vw,180px)}
.close .hero-art::after{background:
  radial-gradient(90% 80% at 50% 50%,rgba(5,2,14,.6),rgba(5,2,14,.9) 60%),
  linear-gradient(180deg,var(--ground),transparent 22%,transparent 66%,var(--void))}
.close .wrap{position:relative; z-index:2; display:grid; gap:24px; justify-items:center}
.close h2{max-width:20ch}
footer{background:var(--void); border-top:1px solid var(--line-soft);
  padding-block:clamp(38px,6vw,64px)}
.foot{display:grid; gap:clamp(28px,4vw,56px); align-items:center;
  grid-template-columns:minmax(0,1fr) auto}
@media (max-width:720px){.foot{grid-template-columns:1fr; justify-items:center; text-align:center}}
.footmark{font-family:Fraunces,Georgia,serif; font-weight:800; font-size:1.6rem; color:#fff;
  letter-spacing:-.015em; margin-bottom:8px}
.foot-say .note{max-width:46ch}
.foot-links{display:flex; flex-wrap:wrap; gap:10px 12px; margin-top:22px}
@media (max-width:720px){.foot-links{justify-content:center}.foot-say .note{margin-inline:auto}}
.foot-links a{display:inline-flex; align-items:center; gap:9px; text-decoration:none;
  color:var(--ink-2); font-size:.88rem; font-weight:600;
  border:1px solid var(--line); border-radius:999px; padding:9px 16px;
  background:linear-gradient(180deg,rgba(24,33,58,.6),rgba(8,6,18,.5));
  transition:border-color .18s ease, color .18s ease, transform .18s ease}
.foot-links a:hover{border-color:var(--violet); color:#fff; transform:translateY(-2px)}
.foot-links svg{width:15px; height:15px; flex:none}
.foot-links .fi{font-size:.62rem; color:var(--violet-lite)}
.qr{margin:0; display:flex; flex-direction:column; align-items:center; gap:11px}
.qr img{width:132px; height:132px; border-radius:12px; padding:8px; background:#fff;
  box-shadow:0 14px 34px -16px rgba(0,0,0,.9)}
.qr figcaption{font-size:.7rem; letter-spacing:.15em; text-transform:uppercase;
  color:var(--faint); font-weight:600}

/* ---------- sticky play (mobile, after hero) ---------- */
.dock{position:fixed; left:0; right:0; bottom:0; z-index:40; padding:12px var(--pad) calc(12px + env(safe-area-inset-bottom));
  background:linear-gradient(180deg,rgba(8,12,24,.1),rgba(5,2,14,.96) 42%);
  transform:translateY(120%); transition:transform .35s ease; pointer-events:none}
.dock.on{transform:none; pointer-events:auto}
.dock .btn{width:100%; padding:16px}
.dock.hush{transform:translateY(120%); pointer-events:none}
@media (max-width:900px){body{padding-bottom:86px}}
@media (min-width:901px){.dock{display:none}}

/* ---------- scroll reveal ---------- */
.rise{opacity:0; transform:translateY(22px); transition:opacity .7s cubic-bezier(.22,.7,.3,1), transform .7s cubic-bezier(.22,.7,.3,1)}
.rise.in{opacity:1; transform:none}
@media (prefers-reduced-motion:reduce){.rise{opacity:1; transform:none}}
</style>
